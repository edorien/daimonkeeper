{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "displayName": "Basic Config",
            "description": "Basic build using Ninja generator",
            "generator": "Ninja",
            "hidden": true,
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        },

        {
            "name": "x64",
            "hidden": true,
            "architecture": {
                "value": "x64",
                "strategy": "external"
            }
        },

        {
            "name": "Debug",
            "displayName": "Config Debug",
            "hidden": true,
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "Release",
            "displayName": "Config Release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },

        {
            "name": "MSVC",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },
        {
            "name": "Clang",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-cl.exe",
                "CMAKE_CXX_COMPILER": "clang-cl.exe"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "intelliSenseMode": "windows-clang-x64"
                }
            }
        },

        {
            "name": "Debug-Clang",
            "displayName": "Debug Clang",
            "inherits": [ "base", "x64", "Debug", "Clang" ],
            "hidden": true
        },
        {
            "name": "Release-Clang",
            "displayName": "Release Clang",
            "inherits": [ "base", "x64", "Release", "Clang" ],
            "hidden": true
        },
        {
            "name": "Debug-MSVC",
            "displayName": "Debug MSVC",
            "inherits": [ "base", "x64", "Debug", "MSVC" ],
            "hidden": true
        },
        {
            "name": "Release-MSVC",
            "displayName": "Release MSVC",
            "inherits": [ "base", "x64", "Release", "MSVC" ],
            "hidden": true
        },

        {
            "name": "MinGW64-Base",
            "hidden": true,
            "inherits": "base",
            "environment": {
                "PATH": "C:/msys64/mingw64/bin;$penv{PATH}"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc.exe",
                "CMAKE_CXX_COMPILER": "g++.exe",
                "VCPKG_TARGET_TRIPLET": "x64-mingw-dynamic"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "intelliSenseMode": "windows-clang-x64"
                }
            }
        },

        {
            "name": "x64-MinGW64-Debug",
            "displayName": "x64-MinGW64-Debug",
            "inherits": [ "MinGW64-Base", "x64", "Debug" ],
            "binaryDir": "${sourceDir}/out/windows/cmake-build-debug",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on"
            }
        },
        {
            "name": "x64-MinGW64-Release",
            "displayName": "x64-MinGW64-Release",
            "inherits": [ "MinGW64-Base", "x64", "Release" ],
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on"
            }
        },

        {
            "name": "linux-deck",
            "displayName": "Linux (Steam Deck bundle)",
            "description": "Native x86-64 Linux build that installs as a self-contained bundle for the Steam Deck. Build in the pinned container (build/docker/deck.Dockerfile) so glibc matches the Deck; see docs/steam-deck.md.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/deck",
            "installDir": "${sourceDir}/out/daimonkeeper-deck",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "KFX_DECK_BUNDLE": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Base",
            "hidden": true,
            "jobs": 8,
            "verbose": true,
            "configurePreset": "Debug"
        },

        {
            "name": "StandardLog",
            "hidden": true,
            "inherits": "Base",
            "targets": "keeperfx"
        },

        {
            "name": "Debug-Clang-Standard",
            "displayName": "Debug Clang Standard",
            "inherits": "StandardLog",
            "configurePreset": "Debug-Clang"
        },
        {
            "name": "Release-Clang-Standard",
            "displayName": "Release Clang Standard",
            "inherits": "StandardLog",
            "configurePreset": "Release-Clang"
        },
        {
            "name": "Debug-MSVC-Standard",
            "displayName": "Debug MSVC Standard",
            "inherits": "StandardLog",
            "configurePreset": "Debug-MSVC"
        },
        {
            "name": "Release-MSVC-Standard",
            "displayName": "Release MSVC Standard",
            "inherits": "StandardLog",
            "configurePreset": "Release-MSVC"
        },

        {
            "name": "Debug-MinGW64-Standard",
            "displayName": "Debug MinGW64 Standard",
            "inherits": "StandardLog",
            "configurePreset": "x64-MinGW64-Debug"
        },
        {
            "name": "Release-MinGW64-Standard",
            "displayName": "Release MinGW64 Standard",
            "inherits": "StandardLog",
            "configurePreset": "x64-MinGW64-Release"
        }
    ]
}
