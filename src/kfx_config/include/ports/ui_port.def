KFX_PORT_VOID(targeted_message_add, (char msg_type, PlayerNumber plyr_idx, PlayerNumber target_idx, uint64_t timeout, const char *msg), (msg_type, plyr_idx, target_idx, timeout, msg))
/* message_add_fmt() is printf-style: the port takes the va_list form, and
   ports/ui_port.h adds a variadic ui_message_add_fmt() by hand. */
KFX_PORT_VOID(message_add_vfmt, (char msg_type, int64_t idx, const char *fmt_str, va_list ap), (msg_type, idx, fmt_str, ap))
KFX_PORT_VOID(message_add, (char msg_type, int64_t idx, const char *msg), (msg_type, idx, msg))
