/* InputFocusPort entries: see ports/input_focus_port.h. One line per entry:
   KFX_PORT_VOID(name, (params), (args))
   KFX_PORT_RET(return_type, name, (params), (args), default_return)
   ..X forms add a statement the unwired default runs first (e.g. zeroing an
   out-parameter; guard pointers against NULL).
   KFX_PORT_RETS(return_type, name, (params), (args), body): the unwired
   default runs body, which returns (a default that is not a constant).
   Refactor pass 2, S15 (docs/refactor-pass2/stage-15-ports-and-events.md). */
KFX_PORT_RET(TbBool, freeze_game_on_focus_lost, (void), (), false)
KFX_PORT_RET(TbBool, mute_audio_on_focus_lost, (void), (), false)
KFX_PORT_RET(TbBool, unlock_cursor_when_game_paused, (void), (), false)
KFX_PORT_RET(TbBool, lock_cursor_in_possession, (void), (), false)
KFX_PORT_RET(TbBool, is_game_paused, (void), (), false)
KFX_PORT_RET(TbBool, is_possession_mode_active, (void), (), false)
KFX_PORT_RET(TbBool, is_packet_load_enabled, (void), (), false)
KFX_PORT_RET(TbBool, use_relative_mouse_mode, (void), (), false)
