# File-name form of the product name (dAImon Keeper): the executable, its
# .map/.debug, the base config, the log, the save folder, package archives.
PRODUCT_SLUG=daimonkeeper

# Product version (dAImon Keeper's own releases).
VER_MAJOR=1
VER_MINOR=0
VER_RELEASE=0
VER_BUILD=0

# Newest KeeperFX *release* whose campaigns/map packs this build fully
# supports, shown as "KFX <major>.<minor>". Bump only after an upstream merge
# brings in everything from that release -- never for alpha-only features.
KFX_COMPAT_MAJOR=1
KFX_COMPAT_MINOR=4

PACKAGE_SUFFIX=---
